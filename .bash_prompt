# shellcheck shell=bash

# Shell prompt based on the Solarized Dark theme.
# Screenshot: http://i.imgur.com/EkEtphC.png
# Heavily inspired by @necolas’s prompt: https://github.com/necolas/dotfiles
# iTerm → Profiles → Text → use 13pt Monaco with 1.1 vertical spacing.

if [[ $COLORTERM = gnome-* && $TERM = xterm ]] && infocmp gnome-256color > /dev/null 2>&1; then
	export TERM='gnome-256color';
elif [[ $TERM = xterm || -z $TERM || $TERM = dumb ]] && infocmp xterm-256color > /dev/null 2>&1; then
	# Only upgrade a bare xterm. tmux-256color, screen-256color and friends are
	# already correct, and overwriting them loses italics and true color.
	export TERM='xterm-256color';
fi;

# One git call answers both questions the prompt needs: which worktree this is —
# its root rather than $PWD, so the title holds in subdirectories — and the
# branch.
prompt_location() {
	local top='' branch='';

	{ read -r top; read -r branch; } < <(
		git rev-parse --show-toplevel --abbrev-ref HEAD 2> /dev/null);

	prompt_branch='';

	case "${top}" in
		'') # Outside a repository, show what \W used to.
			[ "${PWD}" = "${HOME}" ] && prompt_title='~' || prompt_title="${PWD##*/}";
			return;;
		"${HOME}") prompt_title='~';;
		"${HOME}/Projects/"*) prompt_title="${top#"${HOME}/Projects/"}";;
		*) prompt_title="${top##*/}";;
	esac;

	# --abbrev-ref reports the literal HEAD when detached, and before the first
	# commit. Fall back the way this prompt always has.
	if [ -z "${branch}" ] || [ "${branch}" = 'HEAD' ]; then
		branch="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
			git describe --all --exact-match HEAD 2> /dev/null || \
			git rev-parse --short HEAD 2> /dev/null || \
			echo '(unknown)')";
	fi;
	prompt_branch="${branch}";
}

# Emitted here rather than from PS1, so the escape never enters the prompt
# string and needs no \[ \] zero-width markers.
prompt_command() {
	prompt_location;
	printf '\033]0;%s\007' "${prompt_title}";
}

# .bashrc re-sources .bash_profile for every interactive shell, so guard against
# stacking up duplicates in nested shells. Appended rather than prepended: a
# login shell already carries VTE's __vte_prompt_command, which sets a title of
# its own, and the last one to run wins.
case ";${PROMPT_COMMAND};" in
	*';prompt_command;'*) ;;
	*) PROMPT_COMMAND="${PROMPT_COMMAND:+${PROMPT_COMMAND};}prompt_command";;
esac

prompt_git() {
	local s='';

	# prompt_location has already established whether this is a repository.
	[ -n "${prompt_branch}" ] || return;

	# Check for uncommitted changes in the index.
	if ! $(git diff --quiet --ignore-submodules --cached); then
		s+='+';
	fi;
	# Check for unstaged changes.
	if ! $(git diff-files --quiet --ignore-submodules --); then
		s+='!';
	fi;
	# Check for untracked files.
	if [ -n "$(git ls-files --others --exclude-standard)" ]; then
		s+='?';
	fi;
	# Check for stashed files.
	if $(git rev-parse --verify refs/stash &>/dev/null); then
		s+='$';
	fi;

	[ -n "${s}" ] && s=" [${s}]";

	echo -e "${1}${prompt_branch}${2}${s}";
}

if tput setaf 1 &> /dev/null; then
	tput sgr0; # reset colors
	bold=$(tput bold);
	reset=$(tput sgr0);
	# Solarized colors, taken from http://git.io/solarized-colors.
	black=$(tput setaf 0);
	blue=$(tput setaf 33);
	cyan=$(tput setaf 37);
	green=$(tput setaf 64);
	orange=$(tput setaf 166);
	purple=$(tput setaf 125);
	red=$(tput setaf 124);
	violet=$(tput setaf 61);
	white=$(tput setaf 15);
	yellow=$(tput setaf 136);
else
	bold='';
	reset="\e[0m";
	black="\e[1;30m";
	blue="\e[1;34m";
	cyan="\e[1;36m";
	green="\e[1;32m";
	orange="\e[1;33m";
	purple="\e[1;35m";
	red="\e[1;31m";
	violet="\e[1;35m";
	white="\e[1;37m";
	yellow="\e[1;33m";
fi;

# Highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
	userStyle="${red}";
else
	userStyle="${orange}";
fi;

# Highlight the hostname when connected via SSH.
if [[ "${SSH_TTY}" ]]; then
	hostStyle="${bold}${red}";
else
	hostStyle="${yellow}";
fi;

# Set the terminal title and prompt.
PS1="\[${bold}\]\n"; # newline
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${white}\] at ";
PS1+="\[${hostStyle}\]\h"; # host
PS1+="\[${white}\] in ";
PS1+="\[${green}\]\w"; # working directory full path
PS1+="\$(prompt_git \"\[${white}\] on \[${violet}\]\" \"\[${blue}\]\")"; # Git repository details
PS1+="\n";
PS1+="\[${white}\]\$ \[${reset}\]"; # `$` (and reset color)
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
