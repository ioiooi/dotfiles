# shellcheck shell=bash

# Create a new directory and enter it
mkd() {
	if (( $# == 0 )); then
		echo "usage: mkd <dir> [dir ...]" >&2;
		return 2;
	fi;
	mkdir -p -- "$@" && cd -- "${!#}";
}

# fs: Display human-readable file and directory sizes.
#
# Usage: fs [file/directory ...]
#
fs() {
	local arg;
	if du -b /dev/null > /dev/null 2>&1; then
		arg=-sbh;
	else
		arg=-sh;
	fi;
	if (( $# )); then
		du "$arg" -- "$@";
	else
		# dotglob to include hidden entries, nullglob so an empty directory
		# does not pass the literal pattern to du.
		( shopt -s dotglob nullglob; du "$arg" -- ./* );
	fi;
}

# wdiff: Display color-coded word-level differences using 'git diff'.
#
# Named wdiff rather than diff so the real diff(1) stays reachable; its flags
# (-u, -r, -q, -y) mean nothing to git diff.
#
# Note: This function is available only if 'git' is installed.
#
# Usage:
#   wdiff file1 file2
#
if hash git &> /dev/null; then
	wdiff() {
		git diff --no-index --color-words "$@";
	}
fi;

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
tre() {
	if ! hash tree &> /dev/null; then
		echo "tre: tree is not installed" >&2;
		return 1;
	fi;
	tree -aC -I '.git|node_modules|.venv|__pycache__|dist|target|.next' --dirsfirst "$@" | less -FRN;
}

# gcm: Shortcut for 'git commit -m'.
#
# Usage:
#   gcm <commit-message>
#
# Example:
#   gcm "Fix typo in README"
#
gcm() {
	if (( $# == 0 )); then
		echo "usage: gcm <commit-message>" >&2;
		return 2;
	fi;
	git commit -m "$*";
}

# git_amend_to_commit(): Amend current changes to a specific commit.
#
# Creates a "fixup" commit with the staged changes, then runs an interactive
# rebase with --autosquash to fold it into the target commit.
#
# Usage:
#   git_amend_to_commit <target-commit>
#
# Example:
#   git_amend_to_commit abc123
#   git_amend_to_commit HEAD~3
#
git_amend_to_commit() {
	local target_commit=$1;

	if [[ -z "$target_commit" ]]; then
		echo "usage: git_amend_to_commit <target-commit>" >&2;
		return 2;
	fi;

	# Resolve to a fixed sha first: the fixup commit below shifts what a
	# relative ref such as HEAD~3 points at.
	local target_sha;
	if ! target_sha=$(git rev-parse --verify --quiet "${target_commit}^{commit}"); then
		echo "git_amend_to_commit: not a commit: $target_commit" >&2;
		return 2;
	fi;

	git commit --fixup="$target_sha" || return;

	if git rev-parse --verify --quiet "${target_sha}~1" > /dev/null; then
		git rebase -i --autosquash "${target_sha}~1";
	else
		# The target is the first commit and has no parent to rebase onto.
		git rebase -i --autosquash --root;
	fi;
}

# Run a command in a Docker container, or an interactive shell when none is given
dexec() {
	if (( $# == 0 )); then
		echo "usage: dexec <container> [cmd ...]" >&2;
		return 2;
	fi;

	local container=$1;
	shift;

	if (( $# )); then
		docker exec -it "$container" "$@";
	else
		docker exec -it "$container" bash 2> /dev/null || docker exec -it "$container" sh;
	fi;
}

# Stop every running container
docker-stop() {
	local ids;
	ids=$(docker ps -q) || return;

	if [[ -z "$ids" ]]; then
		echo "ℹ️ No running containers found.";
		return 0;
	fi;

	echo "🛑 Stopping all running Docker containers...";
	# $ids unquoted: one argument per container id
	if docker stop $ids; then
		echo "✅ All containers stopped successfully!";
	else
		echo "❌ Some containers could not be stopped." >&2;
		return 1;
	fi;
}

# Remove all Docker data. Irreversible, so it asks first.
docker-purge() {
	echo "WARNING: This will remove ALL Docker data (containers, images, volumes, networks, build cache)!";
	read -r -p "Are you sure you want to continue? (y/N) " -n 1;
	echo;
	if [[ ! $REPLY =~ ^[Yy]$ ]]; then
		echo "Operation cancelled.";
		return 1;
	fi;

	local -a failed=();
	local ids;

	# Every $ids below is unquoted on purpose: one argument per id.
	echo "Stopping all containers...";
	ids=$(docker ps -q);
	if [[ -n "$ids" ]]; then
		docker stop $ids || failed+=("stop containers");
	fi;

	echo "Removing all containers...";
	ids=$(docker ps -aq);
	if [[ -n "$ids" ]]; then
		docker rm -f $ids || failed+=("remove containers");
	fi;

	echo "Removing all images (including intermediate layers)...";
	ids=$(docker images -aq);
	if [[ -n "$ids" ]]; then
		docker rmi -f $ids || failed+=("remove images");
	fi;

	echo "Removing all volumes...";
	ids=$(docker volume ls -q);
	if [[ -n "$ids" ]]; then
		docker volume rm -f $ids || failed+=("remove volumes");
	fi;

	echo "Removing all custom networks...";
	docker network prune -f || failed+=("prune networks");

	echo "Cleaning up build cache...";
	docker builder prune -af || failed+=("prune build cache");

	if (( ${#failed[@]} )); then
		printf 'Docker cleanup finished with errors: %s\n' "${failed[*]}" >&2;
		return 1;
	fi;

	echo "Docker cleanup complete!";
}
