#!/bin/bash

MESSAGE=$(cat "$1")
# symbolic-ref, not rev-parse: this also runs for the first commit in a repo,
# where HEAD does not resolve yet.
TICKET=$(git symbolic-ref --quiet --short HEAD | grep -Eo '[a-zA-Z]+-[0-9]+' | head -n 1 | tr "[:lower:]" "[:upper:]")

if [[ -z "$TICKET" ]]; then
  # TICKET is empty
  exit 0
elif [[ "$MESSAGE" == *"$TICKET"* ]]; then
  exit 0
fi

echo "$TICKET: $MESSAGE" > "$1"
