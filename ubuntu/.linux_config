#!/usr/bin/env bash

# Sourced by .bash_profile for every interactive shell, so it stays cheap:
# no package installs, no sudo prompts, no desktop settings. Installing
# bash-completion is install_packages.sh's job, GNOME settings are
# configure_desktop.sh's.

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
	source /usr/share/bash-completion/bash_completion
elif [[ -r /etc/bash_completion ]]; then
	source /etc/bash_completion
fi
